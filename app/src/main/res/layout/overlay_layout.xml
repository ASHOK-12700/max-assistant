<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#F0000000" android:paddingTop="20dp" android:paddingBottom="30dp" android:paddingStart="24dp" android:paddingEnd="24dp">
    <!--  Top: MAX label + close  -->
    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MAX" android:textColor="#4FC3F7" android:textSize="13sp" android:letterSpacing="0.3" android:textStyle="bold" android:layout_centerVertical="true"/>
        <ImageView android:id="@+id/overlay_close" android:layout_width="32dp" android:layout_height="32dp" android:src="@android:drawable/ic_menu_close_clear_cancel" android:tint="#80FFFFFF" android:layout_alignParentEnd="true" android:padding="4dp"/>
    </RelativeLayout>
    <!--  Center: Loona + animated rings  -->
    <RelativeLayout android:layout_width="match_parent" android:layout_height="150dp" android:layout_marginBottom="16dp">
        <!--  Outer pulse ring  -->
        <ImageView android:id="@+id/ring_outer" android:layout_width="140dp" android:layout_height="140dp" android:layout_centerInParent="true" android:background="@drawable/ring_outer"/>
        <!--  Inner pulse ring  -->
        <ImageView android:id="@+id/ring_inner" android:layout_width="110dp" android:layout_height="110dp" android:layout_centerInParent="true" android:background="@drawable/ring_inner"/>
        <!--  Loona image center  -->
        <ImageView android:id="@+id/overlay_loona" android:layout_width="90dp" android:layout_height="90dp" android:layout_centerInParent="true" android:src="@drawable/loona_open" android:scaleType="centerCrop"/>
    </RelativeLayout>
    <!--  Status text  -->
    <TextView android:id="@+id/overlay_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Listening..." android:textColor="#CCFFFFFF" android:textSize="15sp" android:gravity="center" android:layout_marginBottom="6dp"/>
    <!--  Hint  -->
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Speak your command" android:textColor="#66FFFFFF" android:textSize="12sp" android:gravity="center"/>
</LinearLayout>